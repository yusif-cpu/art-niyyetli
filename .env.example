# Local DEVELOPMENT defaults. For a deployed environment start from
# .env.production.example instead and verify it with `php artisan app:preflight`.
APP_NAME=ArtNiyyetli
APP_ENV=local
APP_KEY=
# Must be false anywhere but a developer machine: true exposes stack traces, file paths and configuration.
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Baku

APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# "daily" rotates and prunes the log file; "single" grows without bound.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Verbose for local work; production should use warning (see .env.production.example).
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=art_niyyetli
DB_USERNAME=art_niyyetli
DB_PASSWORD=change-me

MYSQL_ROOT_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only set to true once the app is served over HTTPS (production).
SESSION_SECURE_COOKIE=false

# Optional local-only dev admin account. Set all three to create one on `db:seed`.
# Never set these in a committed .env or in production — local development only.
# ADMIN_DEV_USERNAME=admin
# ADMIN_DEV_EMAIL=admin@example.test
# ADMIN_DEV_PASSWORD=

# Reverse proxies / load balancers whose X-Forwarded-For/-Proto/-Host/-Port headers are trusted (config/trustedproxy.php):
# comma-separated IPs or CIDRs. Leave EMPTY when nothing sits in front of the app (local Docker): forwarded headers
# from clients are then ignored, so nobody can forge their IP address.
TRUSTED_PROXIES=

# Cross-origin access to the public API (config/cors.php). The SPA is same-origin, so none is needed.
# Unset: the usual local dev-server origins outside production, no origins in production. Set to an empty value for none,
# or to exact origins, comma-separated (never a wildcard).
# PUBLIC_API_CORS_ORIGINS=
# Let those origins also POST (the enquiry form). Only for a separately hosted frontend.
PUBLIC_API_CORS_ALLOW_POST=false

# Security headers (App\Http\Middleware\SecurityHeaders, config/security.php).
# Content-Security-Policy mode: off | report-only | enforce. Keep report-only until the browser console
# shows no "[Report Only]" violations on every public and admin screen.
SECURITY_CSP=report-only
# Optional URL that receives CSP violation reports:
# SECURITY_CSP_REPORT_URI=
# Strict-Transport-Security is only ever sent on HTTPS requests; leave off for local development.
SECURITY_HSTS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_ORIGINAL_DISK=local
MEDIA_PUBLIC_DISK=public
# Largest image an upload may contain (checked before decoding; see config/media.php for the measurements). Raise
# them only together with PHP's memory_limit: decoding needs roughly 4-7 MB of memory per megapixel.
MEDIA_MAX_PIXELS=28000000
MEDIA_MAX_EDGE=12000
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Store for rate-limit counters (public API, enquiry form, admin login/API, media upload). "file" costs no SQL, unlike
# the database store (six statements per throttled request); it needs storage/framework/cache/data to be writable and
# counts per server. Unset or empty means "file"; name another store (e.g. database) to count there instead.
CACHE_LIMITER_STORE=file
# Requests per minute per IP on the public API (default 60) and admin write requests per minute per user (default 240).
RATE_LIMIT_PUBLIC_API=60
RATE_LIMIT_ADMIN_API=240

# Public API caching (config/public_cache.php). Seconds a browser or shared cache may reuse a public GET response
# (Cache-Control max-age + ETag); 0 turns it off. Admin edits reach the application cache at once and HTTP caches
# within this many seconds. Changes made outside the admin (seeders, tinker, SQL) show after at most 5 minutes, or
# immediately after `php artisan public-cache:flush`.
PUBLIC_API_CACHE_TTL=60
# Extra seconds a cache may serve an expired response while it refetches (stale-while-revalidate). 0 omits it.
PUBLIC_API_CACHE_SWR=0

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@artniyyetli.az"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
