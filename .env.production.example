# ArtNiyyətli — PRODUCTION environment template.
#
# Copy to .env on the server and fill in every value marked CHANGE-ME. Then:
#   php artisan key:generate --force
#   php artisan migrate --force
#   php artisan storage:link
#   npm ci && npm run build          (or deploy a pre-built public/build)
#   php artisan app:preflight        (must exit 0 before the site goes live)
#
# This file is tracked and contains NO secrets. The filled-in copy (.env, .env.production)
# is git-ignored: never commit it. For local development use .env.example instead.

APP_NAME=ArtNiyyetli
APP_ENV=production
# Generated by `php artisan key:generate --force`; back it up — losing it invalidates sessions.
APP_KEY=
# Must stay false: true exposes stack traces, file paths and configuration to visitors.
APP_DEBUG=false
# The public origin, with https. It drives canonical URLs, the sitemap, e-mail links and every media URL.
APP_URL=https://CHANGE-ME.example
APP_TIMEZONE=Asia/Baku

APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logging: rotate daily and keep warnings and above (debug logs are large and may contain personal data).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=CHANGE-ME
DB_PORT=3306
DB_DATABASE=art_niyyetli
DB_USERNAME=CHANGE-ME
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# REQUIRED in production: the admin session cookie is only ever sent over HTTPS.
SESSION_SECURE_COOKIE=true

# NEVER set ADMIN_DEV_* in production: the development administrator seeder refuses to run
# when ADMIN_DEV_PASSWORD is present. Create the first administrator through a deliberate,
# audited step instead.

# Security headers (see config/security.php).
# Content-Security-Policy: keep "report-only" until every public and admin screen has been checked in a
# browser with the console open and shows no "[Report Only]" violations; then switch to "enforce".
SECURITY_CSP=report-only
# Optional URL that receives CSP violation reports:
# SECURITY_CSP_REPORT_URI=
# Strict-Transport-Security (one year). Set to true only once the whole site is confirmed to work over
# HTTPS: browsers remember the policy and will refuse plain HTTP for that long.
SECURITY_HSTS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_ORIGINAL_DISK=local
MEDIA_PUBLIC_DISK=public

# Nothing in the application dispatches queued jobs and no queue worker is provisioned;
# enquiry e-mails are sent in-process. Do not rely on the queue until a worker exists.
QUEUE_CONNECTION=database

# The shared store used for caching and rate limiting. "database" works on the existing
# infrastructure but adds SQL to every cache read and rate-limit check (preflight warns);
# "file" is a lighter option on a single server. Never use "array" or "null" here.
CACHE_STORE=database
# CACHE_PREFIX=

# Public API CORS. The SPA is served from the same origin, so leave this EMPTY: no
# cross-origin access is granted. Set it only for a separately hosted frontend, to its exact
# origin(s), comma-separated. Never a wildcard and never a localhost address.
PUBLIC_API_CORS_ORIGINS=

# E-mail. "log" and "array" never deliver, so enquiry notifications would be silently lost.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@artniyyetli.az"
MAIL_FROM_NAME="${APP_NAME}"

# Where new-enquiry notifications go when the admin "contact_email" setting is empty.
ENQUIRY_NOTIFICATION_EMAIL=
GALLERY_CURRENCY=AZN
GALLERY_WHATSAPP_NUMBER=
ALLOW_SOLD_ENQUIRIES=false

VITE_APP_NAME="${APP_NAME}"
